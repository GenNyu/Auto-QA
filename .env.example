# ============================================
# Copy file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# File .env đã được .gitignore, sẽ không bị commit lên git.
# ============================================

# --- LLM gateway của công ty (dùng cho cả sinh câu hỏi lẫn chấm điểm) ---
# Gateway nói giao thức OpenAI, nên khai báo dưới tên provider "openai".
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Mặc định gọi ở chế độ streaming để tránh lỗi 524 (Cloudflare cắt kết nối im
# lặng quá 120s). Chỉ đặt OPENAI_STREAM=0 khi cần đối chứng hai chế độ.
# OPENAI_STREAM=1

# --- Chatbot cần đánh giá (dùng cho bước chạy tự động) ---
CHAT_EMAIL=
CHAT_PASSWORD=

# Trang chat sẽ mở, và tên model chọn trên trang đó.
# Phải viết ĐÚNG như chữ hiển thị trong ô chọn model trên giao diện.
CHAT_URL=https://chat.urbox.dev/
CHAT_MODEL=ENGR Test1

# --- Chỉ cần khi gọi thẳng API chính thức, không qua gateway ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# DEEPSEEK_API_KEY=
